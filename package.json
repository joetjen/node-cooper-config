{
  "name": "cooper-config",
  "version": "0.1.0",
  "private": false,
  "author": "Jan Oetjen <joetjen.riveting388@passmail.net> (http://joetjen.net)",
  "description": "Loads an application's CASC configuration once, at startup, with cooper, and gives the application functions to read it -- typed literals untagged, secrets handled per block.",
  "homepage": "https://github.com/joetjen/node-cooper-config",
  "type": "module",
  "main": "./src/cooper-config.cjs",
  "exports": {
    ".": {
      "import": "./src/cooper-config.js",
      "require": "./src/cooper-config.cjs",
      "default": "./src/cooper-config.cjs"
    },
    "./register": {
      "import": "./src/register.js",
      "require": "./src/register.cjs",
      "default": "./src/register.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cooper-config": "./bin/cooper-config.cjs"
  },
  "files": [
    "src",
    "bin",
    "guides"
  ],
  "license": "Apache-2.0",
  "directories": {
    "src": "./src"
  },
  "dependencies": {
    "cooper": "file:../node-cooper"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "auto-changelog": "^2.6.0",
    "chai": "^6.2.2",
    "fast-check": "^3.23.0",
    "mocha": "^11.7.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test": "npx mocha --recursive test/",
    "autotest": "npx mocha --recursive --watch test/",
    "typecheck": "npx tsc --checkJs --noEmit",
    "precommit": "npm run typecheck && npm test",
    "docs": "npx typedoc",
    "version": "npx auto-changelog --package --template keepachangelog && git add CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/joetjen/node-cooper-config.git"
  },
  "bugs": {
    "url": "https://github.com/joetjen/node-cooper-config/issues",
    "email": "joetjen.riveting388@passmail.net"
  },
  "keywords": [
    "casc",
    "cooper",
    "config",
    "configuration",
    "secrets"
  ]
}
